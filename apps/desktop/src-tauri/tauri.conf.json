{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WHERE",
  "version": "0.1.0",
  "identifier": "de.where.warehouse",
  "build": {
    "frontendDist": "../../web/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../web run dev",
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["resources/demo.sql"],
    "externalBin": ["binaries/where-server"]
  }
}
