# PostgreSQL connection used by the Axum server and by `sqlx` tooling.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/where

# HTTP listener. 8090 because a running legacy instance occupies 8080.
BIND_ADDR=127.0.0.1:8090

# Connection pool size. Ignored when DB_SHARED_BACKEND=1 (pinned to 1).
DB_MAX_CONNECTIONS=10

# Set to 1 for poolers that expose one backend to many clients (PgBouncer in
# transaction mode, or the PGlite dev database). Disables the statement cache and
# pins the pool to a single long-lived connection.
DB_SHARED_BACKEND=

# Per-connection prepared-statement cache size. Defaults to 100, or 0 when
# DB_SHARED_BACKEND=1.
DB_STATEMENT_CACHE=

# Origins allowed to call the API from a browser context (comma separated).
# Defaults to the Tauri webview and the Vite dev server.
CORS_ALLOWED_ORIGINS=

# Apply embedded migrations on startup. Set to 0 when a pipeline owns the schema.
RUN_MIGRATIONS=1

# Tracing filter.
RUST_LOG=info,where_api=debug,where_persistence=debug

# Frontend: leave empty to use same-origin requests (dev proxy / served by Axum).
# Set to the API origin when the SPA is served from somewhere else.
VITE_API_BASE=
